# Copy to .env.local for local development, or set these in Vercel for production.

# Secret used to sign login cookies. Required in production.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string (Neon, Supabase, RDS, anything Postgres).
# Leave this UNSET locally to use the embedded PGlite database in .pglite/.
DATABASE_URL=

# Optional embedded database directory. Leave unset to use .pglite/.
# Give temporary previews a separate directory to protect your household data.
# PGLITE_DIR=/tmp/meals-planner-preview
